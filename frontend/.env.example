# ========================================================
# 🦁 Whitman Frontend - Variables de Entorno (Plantilla)
# ========================================================

# URL de la API del Backend (en local es http://localhost:4000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Google OAuth 2.0 Client ID (obtenido desde console.cloud.google.com)
# Ejemplo: 1234567890-abcdefgh.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Correo autorizado como Administrador General de Google
NEXT_PUBLIC_ADMIN_EMAIL=
