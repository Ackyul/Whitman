# ========================================================
# 🛡️ WHITMAN - Git Ignore Seguro
# ========================================================

# Dependencias
node_modules/
*/node_modules/
.pnp
.pnp.js

# Salidas de compilación y empaquetado
.next/
*/.next/
out/
dist/
build/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Archivos de entorno y credenciales (NUNCA subir a Git)
.env
.env.*
!.env.example
!*/.env.example
*.env
*.env.local
*.env.*.local
frontend/.env.local
backend/.env

# Base de datos local y estados en JSON
data.json
backend/data.json
*/data.json
*.sqlite
*.sqlite3
*.db

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Certificados y llaves privadas
*.pem
*.key
*.cert
*.crt

# Plataformas de despliegue
.vercel/
.turbo/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini
